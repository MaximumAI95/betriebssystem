# Diese Werte NICHT in den Chat kopieren, sondern als Secrets in der Umgebung bzw. auf dem Server hinterlegen.

# Datenbank (Supabase, Region Frankfurt / eu-central-1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Anmeldung CRM-Oberfläche (mind. 32 Zeichen, z. B. openssl rand -hex 32)
SESSION_SECRET=

# Claude API (kommerzielle Bedingungen, Auftragsverarbeitungsvertrag)
ANTHROPIC_API_KEY=

# Lead-Finder: OpenStreetMap (optional anderer Overpass-Server) und Modell für die Einordnung
OVERPASS_URL=https://overpass-api.de/api/interpreter
CLAUDE_MODEL=claude-opus-5-5

# Google Cloud: Places API (New) + PageSpeed Insights API, mit Budget-Limit
GOOGLE_MAPS_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

# Vorschau-Hosting für Demo-Websites
VORSCHAU_DOMAIN=vorschau.example.de

# Kostenbremse je Agentenlauf
AGENT_MAX_EUR_PRO_LAUF=1.5

# Ausbaustufe 1/2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
